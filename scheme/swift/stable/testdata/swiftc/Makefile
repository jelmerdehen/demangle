# Swift symbol corpus generation pipeline
# Swift 6.3 (swift-6.3-RELEASE) — x86_64-unknown-linux-gnu
#
# Targets:
#   compile           — compile src/*.swift → out/*.so  (skips LINUX-SKIP files)
#   extract           — nm -D out/*.so | filter $s T/W → corpus-raw.txt
#   oracle            — run swift-demangle per symbol → corpus.txt
#   clean             — remove out/ corpus-raw.txt corpus.txt
#   regenerate        — clean compile extract oracle
#   check-reproducible — regenerate twice, diff the results

SWIFTC          ?= swiftc
SWIFT_DEMANGLE  ?= swift-demangle
SWIFT_FLAGS     := -emit-library -target x86_64-unknown-linux-gnu -O

SRC_DIR   := src
OUT_DIR   := out
CORPUS_RAW := corpus-raw.txt
CORPUS     := corpus.txt
DIVERGENCES := swiftc-oracle-divergences.txt

# All swift sources; exclude those with LINUX-SKIP in their first 5 lines.
ALL_SRCS := $(wildcard $(SRC_DIR)/*.swift)
SRCS     := $(shell for f in $(ALL_SRCS); do \
               if ! head -5 "$$f" | grep -q 'LINUX-SKIP'; then echo "$$f"; fi; \
             done)
OBJECTS  := $(patsubst $(SRC_DIR)/%.swift,$(OUT_DIR)/%.so,$(SRCS))

.PHONY: compile extract oracle clean regenerate check-reproducible

# ── compile ─────────────────────────────────────────────────────────────────
# Build each non-skipped source file into a shared library under out/.
# Invoked in parallel via $(MAKE) -j$(nproc) when called as `make compile`.
compile: $(OBJECTS)
	@echo "compile: built $(words $(OBJECTS)) shared librar$(if $(filter 1,$(words $(OBJECTS))),y,ies)"

# Derive a valid Swift module name from a filename:
#   01_basic_types.swift → BasicTypes
#   strip leading digits+underscore, replace remaining underscores, capitalise.
module-name = $(shell echo "$(basename $(notdir $(1)))" \
	| sed 's/^[0-9]*_//; s/_\([a-z]\)/\u\1/g; s/^\([a-z]\)/\u\1/')

$(OUT_DIR)/%.so: $(SRC_DIR)/%.swift | $(OUT_DIR)
	$(SWIFTC) $(SWIFT_FLAGS) -module-name $(call module-name,$<) -o $@ $<

$(OUT_DIR):
	mkdir -p $(OUT_DIR)

# ── extract ──────────────────────────────────────────────────────────────────
# Run nm -D on every .so in out/, keep exported T and W symbols that start
# with $$s (Swift stable-ABI mangled names), sort and dedup → corpus-raw.txt.
extract: $(CORPUS_RAW)

$(CORPUS_RAW): $(wildcard $(OUT_DIR)/*.so)
	@if [ -z "$(wildcard $(OUT_DIR)/*.so)" ]; then \
	    echo "extract: no .so files in $(OUT_DIR) — run 'make compile' first"; \
	    exit 1; \
	fi
	nm -D $(OUT_DIR)/*.so \
	    | awk '/ [TW] / { print $$3 }' \
	    | grep '^\$$s' \
	    | sort -u \
	    > $@
	@echo "extract: $$(wc -l < $@) unique symbols → $@"

# ── oracle ───────────────────────────────────────────────────────────────────
# For each symbol in corpus-raw.txt run swift-demangle, write
#   <sym> ---> <demangled>
# to corpus.txt.  Symbols where swift-demangle returns empty or the symbol
# unchanged are written to swiftc-oracle-divergences.txt instead.
oracle: $(CORPUS)

$(CORPUS): $(CORPUS_RAW)
	@echo "oracle: running swift-demangle on $$(wc -l < $(CORPUS_RAW)) symbols…"
	@{ \
	    echo "# Swift corpus — generated by swift-demangle"; \
	    echo "# Swift version: $$( $(SWIFTC) --version 2>&1 | head -1 )"; \
	    echo "# Generated: $$(date -u +%Y-%m-%dT%H:%M:%SZ)"; \
	    echo "# Format: <mangled> ---> <demangled>"; \
	} > $@
	@> $(DIVERGENCES).new
	@{ \
	    echo "# Format: <raw-symbol>"; \
	    echo "# Cause: <brief description>"; \
	    echo "# Oracle output: <verbatim>"; \
	    echo "# Upstream: <bug URL or UNKNOWN>"; \
	} > $(DIVERGENCES).new
	@while IFS= read -r sym; do \
	    out=$$( $(SWIFT_DEMANGLE) "$$sym" 2>/dev/null ); \
	    demangled=$$(echo "$$out" | sed 's/^.*---> //'); \
	    if [ -z "$$out" ] || [ "$$demangled" = "$$sym" ] || [ "$$out" = "$$sym" ]; then \
	        printf '# %s\n# Cause: swift-demangle returned %s\n# Oracle output: %s\n# Upstream: UNKNOWN\n\n' \
	            "$$sym" \
	            "$$([ -z "$$out" ] && echo "empty" || echo "symbol unchanged")" \
	            "$$out" >> $(DIVERGENCES).new; \
	    else \
	        printf '%s ---> %s\n' "$$sym" "$$demangled" >> $@; \
	    fi; \
	done < $(CORPUS_RAW)
	@mv $(DIVERGENCES).new $(DIVERGENCES)
	@echo "oracle: $$(grep -c '^\$$s' $@ || echo 0) demangled → $@"
	@echo "oracle: $$(grep -c '^# [^ ]' $(DIVERGENCES) 2>/dev/null || echo 0) divergence blocks → $(DIVERGENCES)"

# ── clean ────────────────────────────────────────────────────────────────────
clean:
	rm -rf $(OUT_DIR) $(CORPUS_RAW) $(CORPUS)

# ── regenerate ───────────────────────────────────────────────────────────────
regenerate: clean compile extract oracle

# ── check-reproducible ───────────────────────────────────────────────────────
# Run the full pipeline twice into isolated temp dirs; diff corpus.txt to
# ensure the output is deterministic.
check-reproducible:
	@echo "check-reproducible: first run…"
	@TMPDIR_A=$$(mktemp -d); \
	 TMPDIR_B=$$(mktemp -d); \
	 trap 'rm -rf "$$TMPDIR_A" "$$TMPDIR_B"' EXIT; \
	 $(MAKE) --no-print-directory OUT_DIR="$$TMPDIR_A/out" \
	     CORPUS_RAW="$$TMPDIR_A/corpus-raw.txt" \
	     CORPUS="$$TMPDIR_A/corpus.txt" \
	     compile extract oracle; \
	 echo "check-reproducible: second run…"; \
	 $(MAKE) --no-print-directory OUT_DIR="$$TMPDIR_B/out" \
	     CORPUS_RAW="$$TMPDIR_B/corpus-raw.txt" \
	     CORPUS="$$TMPDIR_B/corpus.txt" \
	     compile extract oracle; \
	 echo "check-reproducible: diffing…"; \
	 if diff <(grep ' ---> ' "$$TMPDIR_A/corpus.txt" | sort) \
	         <(grep ' ---> ' "$$TMPDIR_B/corpus.txt" | sort) > /dev/null; then \
	     echo "check-reproducible: PASS — outputs are identical"; \
	 else \
	     echo "check-reproducible: FAIL — non-determinism detected"; \
	     diff <(grep ' ---> ' "$$TMPDIR_A/corpus.txt" | sort) \
	          <(grep ' ---> ' "$$TMPDIR_B/corpus.txt" | sort); \
	     exit 1; \
	 fi
